; SwampTetris: a small SDL3/Nuklear test game written entirely in Scheme.
;
; Build and run:
;   make clean && make WITH_SDL3=1
;   ./swampscheme scripts/swamptetris.scm
;
; Controls: arrows/WASD, Up/W rotate, Space hard-drops, Escape quits.
; This intentionally uses the SDL bridge rather than hidden C game logic:
; timing, held keys, events, window-size, drawing, Nuklear, and optional audio.

(define argv (command-line))
(define BOARD-W 10)
(define BOARD-H 20)
(define CELL 24)
(define BOARD-X 40)
(define BOARD-Y 30)
(define PANEL-X 310)

(define KEY-ESC SDLK_ESCAPE)
(define KEY-ENTER SDLK_RETURN)
(define KEY-UP SDLK_UP)
(define KEY-DOWN SDLK_DOWN)
(define KEY-LEFT SDLK_LEFT)
(define KEY-RIGHT SDLK_RIGHT)
(define KEY-W SDLK_W)
(define KEY-A SDLK_A)
(define KEY-S SDLK_S)
(define KEY-D SDLK_D)
(define KEY-SPACE SDLK_SPACE)

; Seven tetrominoes. Each piece has four rotations; each rotation has four rows.
(define PIECES
  (list
   (list (list "...." "...." "####" "....")
         (list "..#." "..#." "..#." "..#.")
         (list "...." "...." "####" "....")
         (list ".#.." ".#.." ".#.." ".#.."))
   (list (list ".##." ".##." "...." "....")
         (list ".##." ".##." "...." "....")
         (list ".##." ".##." "...." "....")
         (list ".##." ".##." "...." "...."))
   (list (list ".#.." "###." "...." "....")
         (list ".#.." ".##." ".#.." "....")
         (list "...." "###." ".#.." "....")
         (list ".#.." "##.." ".#.." "...."))
   (list (list "##.." ".##." "...." "....")
         (list ".#.." "##.." "#..." "....")
         (list "##.." ".##." "...." "....")
         (list ".#.." "##.." "#..." "...."))
   (list (list ".##." "##.." "...." "....")
         (list "#..." "##.." ".#.." "....")
         (list ".##." "##.." "...." "....")
         (list "#..." "##.." ".#.." "...."))
   (list (list "#..." "###." "...." "....")
         (list ".##." ".#.." ".#.." "....")
         (list "...." "###." "..#." "....")
         (list ".#.." ".#.." "##.." "...."))
   (list (list "..#." ".###" "...." "....")
         (list ".#.." ".#.." ".##." "....")
         (list "...." "###." ".#.." "....")
         (list "##.." ".#.." ".#.." "...."))))

(define COLORS
  (list (list 60 210 230) (list 240 220 60) (list 180 80 220)
        (list 70 210 100) (list 230 70 70) (list 240 150 50)
        (list 70 120 240)))
(define board (make-vector (* BOARD-W BOARD-H) -1))
(define piece 0)
(define rotation 0)
(define piece-x 3)
(define piece-y 0)
(define score 0)
(define lines 0)
(define level 1)
(define running #t)
(define paused #f)
(define game-over #f)
(define last-fall 0)
(define last-horizontal 0)
(define window-w 560)
(define window-h 560)
(define audio-active #f)

(define (cell-index x y) (+ x (* y BOARD-W)))
(define (board-at x y) (vector-ref board (cell-index x y)))
(define (board-put! x y value) (vector-set! board (cell-index x y) value))

(define (clear-board!)
  (let fill ((i 0))
    (when (< i (* BOARD-W BOARD-H))
      (vector-set! board i -1)
      (fill (+ i 1)))))

(define (shape-at x y)
  (let ((shape (list-ref (list-ref PIECES piece) rotation)))
    (string=? (string-ref (list-ref shape y) x) "#")))

(define (blocked? x y)
  (or (< x 0) (>= x BOARD-W) (>= y BOARD-H)
      (and (>= y 0) (not (= (board-at x y) -1)))))

(define (would-collide? nx ny nr)
  (let ((old-rotation rotation))
    (set! rotation nr)
    (let rows ((y 0))
      (if (= y 4)
          (begin (set! rotation old-rotation) #f)
          (let cols ((x 0))
            (if (= x 4)
                (rows (+ y 1))
                (if (and (shape-at x y) (blocked? (+ nx x) (+ ny y)))
                    (begin (set! rotation old-rotation) #t)
                    (cols (+ x 1)))))))))

(define (try-move! dx dy)
  (unless (would-collide? (+ piece-x dx) (+ piece-y dy) rotation)
    (set! piece-x (+ piece-x dx))
    (set! piece-y (+ piece-y dy))
    #t))

(define (rotate!)
  (let ((next (modulo (+ rotation 1) 4)))
    (unless (would-collide? piece-x piece-y next)
      (set! rotation next))))

(define (merge-piece!)
  (let ((shape (list-ref (list-ref PIECES piece) rotation)))
    (let rows ((y 0))
      (unless (= y 4)
        (let cols ((x 0))
          (unless (= x 4)
            (when (and (shape-at x y) (>= (+ piece-y y) 0))
              (board-put! (+ piece-x x) (+ piece-y y) piece))
            (cols (+ x 1))))
        (rows (+ y 1))))))

(define (row-full? y)
  (let scan ((x 0))
    (if (= x BOARD-W)
        #t
        (and (not (= (board-at x y) -1)) (scan (+ x 1))))))

(define (shift-rows-down! from)
  (let rows ((y from))
    (when (> y 0)
      (let cols ((x 0))
        (unless (= x BOARD-W)
          (board-put! x y (board-at x (- y 1)))
          (cols (+ x 1))))
      (rows (- y 1))))
  (let clear ((x 0))
    (when (< x BOARD-W)
      (board-put! x 0 -1)
      (clear (+ x 1)))))

(define (clear-lines!)
  (let scan ((y (- BOARD-H 1)) (removed 0))
    (if (< y 0)
        removed
        (if (row-full? y)
            (begin (shift-rows-down! y) (scan y (+ removed 1)))
            (scan (- y 1) removed)))))

(define (spawn!)
  (set! piece (random-integer 7))
  (set! rotation 0)
  (set! piece-x 3)
  (set! piece-y 0)
  (when (would-collide? piece-x piece-y rotation)
    (set! game-over #t)))

(define (lock-piece!)
  (merge-piece!)
  (let ((removed (clear-lines!)))
    (set! lines (+ lines removed))
    (set! score (+ score (* removed removed 100 level)))
    (set! level (+ 1 (quotient lines 10))))
  (spawn!))

(define (fall!)
  (unless (try-move! 0 1)
    (lock-piece!)))

(define (reset!)
  (clear-board!)
  (set! score 0)
  (set! lines 0)
  (set! level 1)
  (set! game-over #f)
  (set! paused #f)
  (spawn!))

(define (color-for index)
  (list-ref COLORS index))

(define (draw-cell x y index)
  (let ((c (color-for index)))
    (sdl3 "color" (list-ref c 0) (list-ref c 1) (list-ref c 2) 255)
    (sdl3 "fill-rect" (+ BOARD-X (* x CELL)) (+ BOARD-Y (* y CELL))
          (- CELL 2) (- CELL 2))))

(define (draw-board!)
  (sdl3 "color" 12 16 28 255)
  (sdl3 "fill-rect" BOARD-X BOARD-Y (* BOARD-W CELL) (* BOARD-H CELL))
  (let rows ((y 0))
    (unless (= y BOARD-H)
      (let cols ((x 0))
        (unless (= x BOARD-W)
          (let ((value (board-at x y)))
            (unless (= value -1) (draw-cell x y value)))
          (cols (+ x 1))))
      (rows (+ y 1)))))

(define (draw-active!)
  (let ((shape (list-ref (list-ref PIECES piece) rotation)))
    (let rows ((y 0))
      (unless (= y 4)
        (let cols ((x 0))
          (unless (= x 4)
            (when (and (shape-at x y) (>= (+ piece-y y) 0))
              (draw-cell (+ piece-x x) (+ piece-y y) piece))
            (cols (+ x 1))))
        (rows (+ y 1))))))

(define (handle-event! event)
  (cond
    ((= (plist-ref event 'type) SDL_EVENT_QUIT)
     (set! running #f))
    ((= (plist-ref event 'type) SDL_EVENT_KEY_DOWN)
     (let ((key (plist-ref event 'key)))
       (cond
         ((= key KEY-ESC) (set! running #f))
         ((or (= key KEY-UP) (= key KEY-W)) (rotate!))
         ((= key KEY-SPACE)
          (let drop ((moved (try-move! 0 1)))
            (when moved (drop (try-move! 0 1))))
          (lock-piece!))
         ((and game-over (= key KEY-ENTER)) (reset!))
         (else #f))))
    ((= (plist-ref event 'type) SDL_EVENT_WINDOW_RESIZED)
     (let ((size (sdl3 "window-size")))
       (set! window-w (car size))
       (set! window-h (cadr size))))
    (else #f)))

(define (drain-events!)
  (let ((event (sdl3 "event")))
    (when event
      (handle-event! event)
      (drain-events!))))

(define (draw-ui!)
  (nuklear "begin-frame")
  (when (nuklear "begin" "SWAMP TETRIS" PANEL-X 30 220 360)
    (nuklear "row" 28 1)
    (nuklear "label" (string-append "SCORE " (number->string score)))
    (nuklear "row" 28 1)
    (nuklear "label" (string-append "LINES " (number->string lines)))
    (nuklear "row" 28 1)
    (nuklear "label" (string-append "LEVEL " (number->string level)))
    (nuklear "row" 28 1)
    (nuklear "label" (string-append "WINDOW " (number->string window-w)
                                    "x" (number->string window-h)))
    (nuklear "row" 30 1)
    (nuklear "label" "ARROWS/WASD: MOVE")
    (nuklear "row" 28 1)
    (nuklear "label" "UP/W: ROTATE  SPACE: DROP")
    (nuklear "row" 32 1)
    (when (nuklear "button" (if paused "RESUME" "PAUSE"))
      (set! paused (not paused)))
    (nuklear "row" 32 1)
    (when (nuklear "button" "RESIZE WINDOW")
      (if (= window-w 560)
          (sdl3 "set-window-size" 640 600)
          (sdl3 "set-window-size" 560 560)))
    (when (nuklear "button" (if audio-active "AUDIO OFF" "AUDIO INIT"))
      (if audio-active
          (begin (sdl3 "audio-shutdown") (set! audio-active #f))
          (begin (sdl3 "audio-init") (set! audio-active #t))))
    (when (nuklear "button" "QUIT") (set! running #f))
    (when game-over
      (nuklear "row" 30 1)
      (nuklear "label" "GAME OVER - ENTER TO RESTART"))
    (nuklear "end"))
  (nuklear "render"))

(sdl3 "init" 560 560 "SwampTetris - SDL3 bridge test")
(let ((size (sdl3 "window-size")))
  (set! window-w (car size))
  (set! window-h (cadr size)))
(reset!)
(set! last-fall (sdl3 "ticks"))
(set! last-horizontal last-fall)

(let game-loop ()
  (sdl3 "clear" 5 8 18 255)
  (sdl3 "begin-frame")
  (drain-events!)
  (let ((now (sdl3 "ticks")))
    (unless (or paused game-over)
      (when (>= (- now last-fall) (max 80 (- 650 (* level 45))))
        (set! last-fall now)
        (fall!))
      (when (>= (- now last-horizontal) 90)
        (set! last-horizontal now)
        (cond
          ((or (sdl3 "key-down?" KEY-LEFT) (sdl3 "key-down?" KEY-A))
           (try-move! -1 0))
          ((or (sdl3 "key-down?" KEY-RIGHT) (sdl3 "key-down?" KEY-D))
           (try-move! 1 0))
          ((or (sdl3 "key-down?" KEY-DOWN) (sdl3 "key-down?" KEY-S))
           (fall!)))))
  (draw-board!)
  (unless game-over (draw-active!))
  (draw-ui!)
  (sdl3 "present")
  (when running
    (sdl3 "delay" 8)
    (game-loop))))

(when audio-active (sdl3 "audio-shutdown"))
(sdl3 "shutdown")
(display (string-append "SWAMP TETRIS: SCORE " (number->string score)
                        " LINES " (number->string lines) "\n"))
