(import scheme (chicken base) (chicken condition) termbox)
(define (check-test value) (unless value (error "Assertion failed")))
(define (raises? thunk) (handle-exceptions ex #t (thunk) #f))
(check-test (eq? tb termbox))
(check-test (= TB_KEY_CTRL_C 3))
(check-test (= (plist-ref '(type 1 key 27) 'key 0) 27))
(check-test (raises? (lambda () (tb 'unknown))))
(check-test (raises? (lambda () (tb 'set-cell 1 2))))
(check-test (tb 'shutdown))
(display "Smoke tests passed\n")
