(import scheme (chicken base) (chicken condition) termbox)
(define (check-test v) (unless v (error "Terminal assertion failed")))
(call-with-termbox
 (lambda ()
  (check-test (> (tb 'width) 0))
  (tb 'clear)
  (tb 'goto 1 1)
  (tb 'attrs 'green 'default)
  (tb 'print "ab")
  (tb 'print "c")
  (check-test (= (plist-ref (tb 'cell-at 3 1) 'ch) 99))
  (tb 'set-cell 4 1 "é" TB_WHITE TB_DEFAULT)
  (check-test (= (plist-ref (tb 'cell-at 4 1) 'ch) 233))
  (tb 'present)
  (check-test (not (tb 'peek-event 1)))
  (display "READY") (flush-output)
  (let ((ev (tb 'peek-event 3000)))
   (check-test ev)
   (check-test (= (plist-ref ev 'ch) 113)))))
(handle-exceptions ex #t
 (call-with-termbox (lambda () (error "Intentional failure"))))
;; A fresh session proves shutdown ran after the exception.
(call-with-termbox (lambda () (check-test (> (tb 'width) 0))))
(display "TERMINAL-PASS\n")
