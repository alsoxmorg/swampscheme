  (define active? #f)
  (define fg TB_DEFAULT)
  (define bg TB_DEFAULT)
  (define x 0)
  (define y 0)
  (define (check rv) (if (< rv 0) (error 'termbox "Termbox operation failed" rv) rv))
  (define (ensure!)
    (unless active?
      (check (raw-init))
      (set! active? #t)
      (raw-output TB_OUTPUT_256)
      (set! fg TB_DEFAULT) (set! bg TB_DEFAULT) (set! x 0) (set! y 0)))
  (define (text v) (if (symbol? v) (symbol->string v) v))
  (define (attr v)
    (if (integer? v) v
        (let ((a (assq (if (string? v) (string->symbol v) v)
                      `((default . ,TB_DEFAULT) (black . ,TB_BLACK) (red . ,TB_RED)
                        (green . ,TB_GREEN) (yellow . ,TB_YELLOW) (blue . ,TB_BLUE)
                        (magenta . ,TB_MAGENTA) (cyan . ,TB_CYAN) (white . ,TB_WHITE)
                        (bold . ,TB_BOLD) (underline . ,TB_UNDERLINE)
                        (reverse . ,TB_REVERSE) (italic . ,TB_ITALIC)))))
          (if a (cdr a) (error 'termbox "Unknown attribute" v)))))
  (define (codepoint v)
    (cond ((integer? v) v) ((char? v) (char->integer v))
          ((or (string? v) (symbol? v))
           (let ((s (text v)))
             (if (zero? (string-length s)) (error 'termbox "Empty character") (raw-char s))))
          (else (error 'termbox "Expected character" v))))
  (define (plist-ref xs key #!optional (default #f))
    (cond ((null? xs) default) ((eq? (car xs) key) (cadr xs))
          (else (plist-ref (cddr xs) key default))))
  (define (event)
    (list 'type (event-type) 'key (event-key) 'ch (event-ch) 'mod (event-mod)
          'w (event-w) 'h (event-h) 'x (event-x) 'y (event-y)))
  (define (call-with-termbox thunk)
    (dynamic-wind ensure! thunk (lambda () (termbox 'shutdown))))
  (define (termbox command . args)
    (let ((cmd (if (string? command) (string->symbol command) command)))
      (if (memq cmd '(shutdown tb_shutdown))
          (begin
            (unless (null? args) (error 'termbox "Wrong argument count" cmd))
            (when active? (check (raw-shutdown)) (set! active? #f)) #t)
          (let* ((entry (assq cmd operations)))
            (unless entry (error 'termbox "Unknown command" command))
            (unless (= (length args) (cadr entry)) (error 'termbox "Wrong argument count" cmd))
            (ensure!)
            (apply (caddr entry) args)))))
  (define tb termbox)
  (define operations
    (let ((init (lambda () '()))
          (clear (lambda () (check (raw-clear)) (set! x 0) (set! y 0) '()))
          (present (lambda () (check (raw-present)) '()))
          (cursor (lambda (a b) (check (raw-cursor a b)) '()))
          (cell (lambda (a b c f g) (check (raw-cell a b (codepoint c) (attr f) (attr g))) '()))
          (input (lambda (mode) (check (raw-input mode))))
          (output (lambda (mode) (check (raw-output mode))))
          (poll (lambda () (check (raw-poll)) (event))))
      `((init 0 ,init) (tb_init 0 ,init)
        (clear 0 ,clear) (tb_clear 0 ,clear)
        (present 0 ,present) (tb_present 0 ,present)
        (width 0 ,raw-width) (height 0 ,raw-height)
        (setcolor 1 ,(lambda (v) (set! fg (attr v))))
        (fg 1 ,(lambda (v) (set! fg (attr v))))
        (setbg 1 ,(lambda (v) (set! bg (attr v))))
        (bg 1 ,(lambda (v) (set! bg (attr v))))
        (attrs 2 ,(lambda (f g) (set! fg (attr f)) (set! bg (attr g))))
        (goto 2 ,(lambda (a b) (set! x (max 0 a)) (set! y (max 0 b))))
        (move 2 ,(lambda (a b) (set! x (max 0 a)) (set! y (max 0 b))))
        (set-cursor 2 ,cursor) (cursor 2 ,cursor)
        (hide-cursor 0 ,(lambda () (check (raw-hide)) '()))
        (set-cell 5 ,cell) (cell 5 ,cell)
        (extend-cell 3 ,(lambda (a b c) (check (raw-extend a b (codepoint c))) '()))
        (print-at 5 ,(lambda (a b f g s) (check (raw-print a b (attr f) (attr g) (text s))) '()))
        (print 1 ,(lambda (s) (check (raw-print x y fg bg (text s))) (set! x (+ x (text-width (text s)))) '()))
        (set-clear-attrs 2 ,(lambda (f g) (check (raw-clear-attrs (attr f) (attr g))) '()))
        (clear-attrs 2 ,(lambda (f g) (check (raw-clear-attrs (attr f) (attr g))) '()))
        (input-mode 1 ,input) (set-input-mode 1 ,input)
        (output-mode 1 ,output) (set-output-mode 1 ,output)
        (poll-event 0 ,poll) (tb_poll_event 0 ,poll) (event 0 ,poll)
        (peek-event 1 ,(lambda (timeout)
                        (let ((rv (raw-peek timeout)))
                          (if (= rv no-event) #f (begin (check rv) (event))))))
        (send 1 ,(lambda (s) (check (raw-send (text s))) '()))
        (last-errno 0 ,raw-errno)
        (cell-at 2 ,(lambda (a b)
                     (unless (and (<= 0 a) (< a (raw-width)) (<= 0 b) (< b (raw-height)))
                       (error 'termbox "Cell out of bounds" a b))
                     (list 'ch (raw-cell-field a b 0) 'fg (raw-cell-field a b 1) 'bg (raw-cell-field a b 2)))))))
