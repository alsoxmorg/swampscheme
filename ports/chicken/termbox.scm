  (define raw-cell-field (foreign-lambda unsigned-int "swamp_cell" int int int))
  (define text-width (foreign-lambda int "swamp_width" c-string))
  (define no-event (foreign-value "TB_ERR_NO_EVENT" int))
  (define raw-poll (foreign-lambda* int () "C_return(tb_poll_event(&swamp_event));"))
  (define raw-peek (foreign-lambda* int ((int timeout)) "C_return(tb_peek_event(&swamp_event,timeout));"))
  (define raw-send (foreign-lambda* int ((c-string text)) "C_return(tb_send(text,strlen(text)));"))
  (define event-type (foreign-lambda* int () "C_return(swamp_event.type);"))
  (define event-key (foreign-lambda* int () "C_return(swamp_event.key);"))
  (define event-ch (foreign-lambda* int () "C_return(swamp_event.ch);"))
