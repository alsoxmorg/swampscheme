  (define raw-extend (foreign-lambda int "tb_extend_cell" int int unsigned-int))
  (define raw-print (foreign-lambda int "tb_print" int int unsigned-int unsigned-int c-string))
  (define raw-clear-attrs (foreign-lambda int "tb_set_clear_attrs" unsigned-int unsigned-int))
  (define raw-input (foreign-lambda int "tb_set_input_mode" int))
  (define raw-output (foreign-lambda int "tb_set_output_mode" int))
  (define raw-errno (foreign-lambda int "tb_last_errno" ))
