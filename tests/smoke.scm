(write-file "/tmp/swampscheme-load-path/child.scm" "(define loaded-child (current-load-directory))\n")
(write-file "/tmp/swampscheme-load-path/parent.scm" "(load-relative \"child.scm\")\n(define loaded-parent (list (current-load-directory) (resolve-load-path \"child.scm\") loaded-child))\n")
